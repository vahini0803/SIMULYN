{
  "name": "simulyn",
  "version": "0.1.0",
  "private": true,
  "description": "SIMULYN — virtual engineering labs platform for programming & electronics education",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @simulyn/shared db:generate",
    "db:migrate": "pnpm --filter @simulyn/shared db:migrate",
    "db:push": "pnpm --filter @simulyn/shared db:push",
    "db:seed": "pnpm --filter @simulyn/shared db:seed",
    "db:studio": "pnpm --filter @simulyn/shared db:studio",
    "db:reset": "pnpm --filter @simulyn/shared db:reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
