# ── local development (SQLite) ────────────────────────────────────────
# Relative paths resolve against packages/shared/prisma/, so this is
# packages/shared/prisma/dev.db regardless of where you run a command from.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
OLLAMA_URL="http://localhost:11434/api/chat"
OLLAMA_MODEL="phi3"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── code execution ────────────────────────────────────────────────────
EXEC_MAX_CONCURRENCY=20
EXEC_TIMEOUT_MS=8000
# Set these only when a toolchain is not on PATH.
# PYTHON_BIN=
# CXX_BIN=
# JAVAC_BIN=
# JAVA_BIN=

# ── optional cloud fallback for the AI mentor ─────────────────────────
# CLOUD_LLM_PROVIDER=anthropic
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=claude-sonnet-5

# ── docker deployment (PostgreSQL) ────────────────────────────────────
# Required by docker-compose.prod.yml; scripts/deploy.sh refuses to run
# without them. DATABASE_URL above is ignored there — it is composed from
# these values instead.
POSTGRES_USER=simulyn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=simulyn
